{
  "name": "4d-testing-extension",
  "displayName": "4D Testing Extension",
  "description": "VS Code 4D Testing Extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamescoot/4d-testing-extension"
  },
  "publisher": "ScottHarris",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.4dm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "4D Testing Extension",
      "properties": {
        "4d-testing-extension.tool4dPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the tool4D (or 4D) executable. Passed as the TOOL4D parameter to make. Leave empty to use the Makefile default."
        }
      }
    },
    "commands": [
      {
        "command": "4d-testing-extension.runTests",
        "title": "4d-testing-extension: Run Tests"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.0",
    "tslint": "^6.1.3",
    "@vscode/vsce": "^2.28.0",
    "ovsx": "^0.9.2"
  }
}
